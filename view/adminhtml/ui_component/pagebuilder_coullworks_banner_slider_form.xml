<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_base_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pagebuilder_coullworks_banner_slider_form.pagebuilder_coullworks_banner_slider_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Banner Slider</item>
    </argument>
    <settings>
        <deps>
            <dep>pagebuilder_coullworks_banner_slider_form.pagebuilder_coullworks_banner_slider_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_coullworks_banner_slider_form</namespace>
    </settings>
    <dataSource name="pagebuilder_coullworks_banner_slider_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_coullworks_banner_slider_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="20">
        <settings>
            <label/>
        </settings>
        <field name="slider_id" sortOrder="10" formElement="select">
            <settings>
                <label translate="true">Slider</label>
                <dataType>text</dataType>
                <dataScope>slider_id</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <caption translate="true">-- Please Select a Slider --</caption>
                        <options class="CoullWorks\BannerSlider\Model\Config\Source\BannerSlider"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="full_width" sortOrder="20" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Full Width</label>
                <dataType>text</dataType>
                <dataScope>full_width</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="full_height" sortOrder="30" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Full Page Height</label>
                <dataType>text</dataType>
                <dataScope>full_height</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="show_tabs" sortOrder="40" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Show Tabs Under Banner</label>
                <dataType>text</dataType>
                <dataScope>show_tabs</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="is_parallax" sortOrder="50" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">0</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Parallax</label>
                <dataType>text</dataType>
                <dataScope>is_parallax</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
