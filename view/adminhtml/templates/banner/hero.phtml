/**
 * Page Builder stage preview of the Hero Banner: the banner image and its overlay, static and unlinked.
 *
 * @var \CoullWorks\BannerSlider\Block\Widget\HeroBanner $block
 * @var \Magento\Framework\Escaper $escaper
 */
$slide = $block->getSlide();
$desktopImg = $slide ? (string)$slide->getBannerImage() : '';
?>
<?php if ($slide && $slide->getEnabled()) : ?>
    <div class="cw-stage-banner cw-stage-hero">
        <picture>
            <img src="<?= $escaper->escapeUrl($block->getOptimizedUrl($desktopImg, 1280, '')); ?>" alt="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>">
        </picture>
        <?php if ($slide->getShowBannerOverlay()) : ?>
            <div class="cw-stage-overlay">
                <?= /* @noEscape */ $block->processContent($slide->getBannerOverlayContent()); ?>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>
