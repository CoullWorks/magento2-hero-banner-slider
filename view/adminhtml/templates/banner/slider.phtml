/**
 * Page Builder stage preview of the Banner Slider: the first enabled slide, with the slide count.
 *
 * @var \CoullWorks\BannerSlider\Block\Widget\BannerSlider $block
 * @var \Magento\Framework\Escaper $escaper
 */
$slider = $block->getSlider();
$slides = ($slider && $slider->getEnabled()) ? $block->getActiveSlides($slider) : [];
$first = $slides ? $slides[0] : null;
?>
<?php if ($first) : ?>
    <div class="cw-stage-banner cw-stage-slider">
        <picture>
            <img src="<?= $escaper->escapeUrl($block->getOptimizedUrl((string)$first->getBannerImage(), 1280, '')); ?>" alt="<?= $escaper->escapeHtmlAttr($first->getBannerName()); ?>">
        </picture>
        <?php if ($first->getShowBannerOverlay()) : ?>
            <div class="cw-stage-overlay">
                <?= /* @noEscape */ $block->processContent($first->getBannerOverlayContent()); ?>
            </div>
        <?php endif; ?>
        <span class="cw-stage-count"><?= $escaper->escapeHtml(__('Slides: %1', count($slides))); ?></span>
    </div>
<?php endif; ?>
