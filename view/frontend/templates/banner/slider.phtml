/**
 * @var $block \CoullWorks\BannerSlider\Block\Widget\BannerSlider
 * @var \Magento\Framework\Escaper $escaper
 */
$slider = $block->getSlider();
$slides = ($slider && $slider->getEnabled()) ? $block->getActiveSlides($slider) : [];
$sliderId = $block->getHtmlId();
$tabsId = $block->getTabsHtmlId();
?>
<?php if ($slides) : ?>
    <div id="<?= $escaper->escapeHtmlAttr($sliderId); ?>" class="slider <?= $escaper->escapeHtmlAttr($block->getClass()); ?>">
        <?php foreach ($slides as $slideIndex => $slide) : ?>
            <?php
            /** @var $slide \CoullWorks\BannerSlider\Api\Data\BannersInterface */
            $desktopImg = (string)$slide->getBannerImage();
            $mobileImg = $slide->getBannerImageMobile() ? (string)$slide->getBannerImageMobile() : $desktopImg;
            $eager = $slideIndex === 0;
            $overlayHtml = $slide->getShowBannerOverlay() ? (string)$block->processContent($slide->getBannerOverlayContent()) : '';
            // An anchor cannot contain another anchor: when the overlay has its own links the banner link becomes a stretched link.
            $stretchLink = $slide->getBannerLink() && preg_match('/<a[\s>]/i', $overlayHtml) === 1;
            $wrapLink = $slide->getBannerLink() && !$stretchLink;
            ?>
            <div class="slide<?= $stretchLink ? ' has-stretched-link' : '' ?>">
                <?php if ($wrapLink) : ?>
                <a href="<?= $escaper->escapeUrl($slide->getBannerLink());?>" title="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>">
                <?php endif; ?>
                    <picture class="<?= $escaper->escapeHtmlAttr($block->getImageClass()); ?>">
                        <source media="(min-width: 768px)" type="image/webp" srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($desktopImg, 1920, 'webp')); ?>">
                        <source media="(min-width: 768px)" srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($desktopImg, 1920, '')); ?>">
                        <source type="image/webp" srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($mobileImg, 828, 'webp')); ?>">
                        <img src="<?= $escaper->escapeUrl($block->getOptimizedUrl($mobileImg, 828, '')); ?>" alt="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>" loading="<?= $eager ? 'eager' : 'lazy' ?>"<?= $eager ? ' fetchpriority="high"' : '' ?> decoding="async" style="width:auto;">
                    </picture>

                    <?php if ($slide->getShowBannerOverlay()) : ?>
                        <div class="overlay">
                            <div class="inner">
                                <?= /* @noEscape */ $overlayHtml; ?>
                            </div>
                        </div>
                    <?php endif; ?>
                <?php if ($wrapLink) : ?>
                </a>
                <?php elseif ($stretchLink) : ?>
                <a class="banner-link" href="<?= $escaper->escapeUrl($slide->getBannerLink());?>" title="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>" aria-label="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>"></a>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
    <script type="text/x-magento-init">
    {
        "#<?= $escaper->escapeJs($sliderId); ?>": {
            "slider": <?= /* @noEscape */ $block->getSliderConfig(); ?>
        }
    }
    </script>
    <?php if ($block->getData('is_parallax')) : ?>
        <script type="text/x-magento-init">
        {
            "#<?= $escaper->escapeJs($sliderId); ?> .img-parallax": {
                "parallax": {}
            }
        }
        </script>
    <?php endif; ?>
    <?php if ($block->showTabs()) : ?>
        <div id="<?= $escaper->escapeHtmlAttr($tabsId); ?>" class="tabs full-width">
            <?php foreach ($slides as $slide) : ?>
                <div class="tab">
                    <h4><?= $escaper->escapeHtml($slide->getBannerName());?></h4>
                </div>
            <?php endforeach; ?>
        </div>
        <script type="text/x-magento-init">
        {
            "#<?= $escaper->escapeJs($tabsId); ?>": {
                "slider": <?= /* @noEscape */ $block->getTabsConfig(); ?>
            }
        }
        </script>
    <?php endif; ?>
<?php endif; ?>
