/**
 * @var $block \CoullWorks\BannerSlider\Block\Widget\HeroBanner
 * @var \Magento\Framework\Escaper $escaper
 */
$slide = $block->getSlide();
$overlayHtml = ($slide && $slide->getShowBannerOverlay()) ? (string)$block->processContent($slide->getBannerOverlayContent()) : '';
// An anchor cannot contain another anchor: when the overlay has its own links the banner link becomes a stretched link.
$stretchLink = $slide && $slide->getBannerLink() && preg_match('/<a[\s>]/i', $overlayHtml) === 1;
$wrapLink = $slide && $slide->getBannerLink() && !$stretchLink;
?>
<?php if($slide): ?>
    <?php if($slide->getEnabled()) : ?>
        <div id="<?= $escaper->escapeHtmlAttr($block->getHtmlId()); ?>" class="hero <?= $escaper->escapeHtmlAttr($block->getClass()); ?>">
            <div class="banner<?= $stretchLink ? ' has-stretched-link' : '' ?>">
                <?php if($wrapLink) :?>
                    <a href="<?= $escaper->escapeUrl($slide->getBannerLink());?>" title="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>">
                <?php endif; ?>
                <?php
                $desktopImg = (string)$slide->getBannerImage();
                $mobileImg = $slide->getBannerImageMobile() ? (string)$slide->getBannerImageMobile() : $desktopImg;
                ?>
                <picture class="<?= $escaper->escapeHtmlAttr($block->getImageClass()); ?>">
                    <source media="(min-width: 768px)" type="image/webp"
                            srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($desktopImg, 1920, 'webp')); ?>">
                    <source media="(min-width: 768px)"
                            srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($desktopImg, 1920, '')); ?>">
                    <source type="image/webp"
                            srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($mobileImg, 828, 'webp')); ?>">
                    <img src="<?= $escaper->escapeUrl($block->getOptimizedUrl($mobileImg, 828, '')); ?>"
                         alt="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>"
                         loading="eager" fetchpriority="high" decoding="async">
                </picture>

                <?php if($slide->getShowBannerOverlay()) : ?>
                    <div class="overlay">
                        <div class="inner">
                            <?= /* @noEscape */ $overlayHtml; ?>
                        </div>
                    </div>
                <?php endif; ?>
                <?php if($wrapLink) :?>
                    </a>
                <?php elseif($stretchLink) :?>
                    <a class="banner-link" href="<?= $escaper->escapeUrl($slide->getBannerLink());?>" title="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>" aria-label="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>"></a>
                <?php endif; ?>
            </div>
        </div>
        <?php if ($block->getData('is_parallax')) : ?>
        <script type="text/x-magento-init">
        {
           "#<?= $escaper->escapeJs($block->getHtmlId()); ?> .img-parallax": {
               "parallax": {}
           }
        }
        </script>
        <?php endif; ?>
    <?php endif; ?>
<?php endif; ?>
