/**
 * @var $block \CoullWorks\BannerSlider\Block\Widget\HeroBanner
 * @var \Magento\Framework\Escaper $escaper
 */
$slide = $block->getSlide();
?>
<?php if($slide): ?>
    <?php if($slide->getEnabled()) : ?>
        <div class="hero <?= $escaper->escapeHtmlAttr($block->getClass()); ?>">
            <div class="banner">
                <?php if($slide->getBannerLink()) :?>
                    <a href="<?= $escaper->escapeUrl($slide->getBannerLink());?>" title="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>">
                <?php endif; ?>
                <?php
                $desktopImg = (string)$slide->getBannerImage();
                $mobileImg = $slide->getBannerImageMobile() ? (string)$slide->getBannerImageMobile() : $desktopImg;
                ?>
                <picture class="<?= $escaper->escapeHtmlAttr($block->getImageClass()); ?>">
                    <source media="(min-width: 768px)" type="image/webp"
                            srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($desktopImg, 1920, 'webp')); ?>">
                    <source media="(min-width: 768px)"
                            srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($desktopImg, 1920, '')); ?>">
                    <source type="image/webp"
                            srcset="<?= $escaper->escapeUrl($block->getOptimizedUrl($mobileImg, 828, 'webp')); ?>">
                    <img src="<?= $escaper->escapeUrl($block->getOptimizedUrl($mobileImg, 828, '')); ?>"
                         alt="<?= $escaper->escapeHtmlAttr($slide->getBannerName()); ?>"
                         loading="eager" fetchpriority="high" decoding="async">
                </picture>

                <?php if($slide->getShowBannerOverlay()) : ?>
                    <div class="overlay">
                        <div class="inner">
                            <?= /* @noEscape */ $block->processContent($slide->getBannerOverlayContent()); ?>
                        </div>
                    </div>
                <?php endif; ?>
                <?php if($slide->getBannerLink()) :?>
                    </a>
                <?php endif; ?>
            </div>
        </div>
        <script type="text/x-magento-init">
        {
           ".img-parallax": {
               "parallax": {}
           }
        }
        </script>
    <?php endif; ?>
<?php endif; ?>
