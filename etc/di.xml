<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<preference for="CoullWorks\BannerSlider\Api\BannerSliderRepositoryInterface" type="CoullWorks\BannerSlider\Model\BannerSliderRepository"/>
	<preference for="CoullWorks\BannerSlider\Api\Data\BannerSliderInterface" type="CoullWorks\BannerSlider\Model\Data\BannerSlider"/>

	<!-- Seperation Logic Banners -->
	<preference for="CoullWorks\BannerSlider\Api\Command\Banners\DeleteByIdInterface" type="CoullWorks\BannerSlider\Model\Command\Banners\DeleteById"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\Banners\DeleteInterface" type="CoullWorks\BannerSlider\Model\Command\Banners\Delete"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\Banners\GetInterface" type="CoullWorks\BannerSlider\Model\Command\Banners\Get"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\Banners\SaveInterface" type="CoullWorks\BannerSlider\Model\Command\Banners\Save"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\Banners\GetListInterface" type="CoullWorks\BannerSlider\Model\Command\Banners\GetList"/>
	<!-- END Seperation Logic Banners -->

	<!-- Seperation Logic BannerSlider -->
	<preference for="CoullWorks\BannerSlider\Api\Command\BannerSlider\DeleteByIdInterface" type="CoullWorks\BannerSlider\Model\Command\BannerSlider\DeleteById"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\BannerSlider\DeleteInterface" type="CoullWorks\BannerSlider\Model\Command\BannerSlider\Delete"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\BannerSlider\GetInterface" type="CoullWorks\BannerSlider\Model\Command\BannerSlider\Get"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\BannerSlider\SaveInterface" type="CoullWorks\BannerSlider\Model\Command\BannerSlider\Save"/>
	<preference for="CoullWorks\BannerSlider\Api\Command\BannerSlider\GetListInterface" type="CoullWorks\BannerSlider\Model\Command\BannerSlider\GetList"/>
	<!-- END Seperation Logic BannerSlider -->

	<preference for="CoullWorks\BannerSlider\Api\Data\BannerSliderSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>
	<virtualType name="CoullWorks\BannerSlider\Model\ResourceModel\BannerSlider\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
		<arguments>
			<argument name="mainTable" xsi:type="string">coullworks_banner_slider_bannerslider</argument>
			<argument name="resourceModel" xsi:type="string">CoullWorks\BannerSlider\Model\ResourceModel\BannerSlider\Collection</argument>
		</arguments>
	</virtualType>
	<type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
		<arguments>
			<argument name="collections" xsi:type="array">
				<item name="coullworks_banner_slider_bannerslider_listing_data_source" xsi:type="string">CoullWorks\BannerSlider\Model\ResourceModel\BannerSlider\Grid\Collection</item>
				<item name="coullworks_banner_slider_banners_listing_data_source" xsi:type="string">CoullWorks\BannerSlider\Model\ResourceModel\Banners\Grid\Collection</item>
			</argument>
		</arguments>
	</type>
	<preference for="CoullWorks\BannerSlider\Api\BannersRepositoryInterface" type="CoullWorks\BannerSlider\Model\BannersRepository"/>
	<preference for="CoullWorks\BannerSlider\Api\Data\BannersInterface" type="CoullWorks\BannerSlider\Model\Data\Banners"/>
	<preference for="CoullWorks\BannerSlider\Api\Data\BannersSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>
	<virtualType name="CoullWorks\BannerSlider\Model\ResourceModel\Banners\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
		<arguments>
			<argument name="mainTable" xsi:type="string">coullworks_banner_slider_banners</argument>
			<argument name="resourceModel" xsi:type="string">CoullWorks\BannerSlider\Model\ResourceModel\Banners\Collection</argument>
		</arguments>
	</virtualType>

	<type name="CoullWorks\BannerSlider\Controller\Adminhtml\Upload\Image">
		<arguments>
			<argument name="imageUploader" xsi:type="object">CoullWorks\BannerSlider\Model\ImageUpload</argument>
		</arguments>
	</type>
	<type name="CoullWorks\BannerSlider\Controller\Adminhtml\Banners\Save">
		<arguments>
			<argument name="imageUpload" xsi:type="object">CoullWorks\BannerSlider\Model\ImageUpload</argument>
		</arguments>
	</type>
	<virtualType name="CoullWorks\BannerSlider\Model\ImageUpload" type="Magento\Catalog\Model\ImageUploader">
		<arguments>
			<argument name="baseTmpPath" xsi:type="string">banner/tmp/image</argument>
			<argument name="basePath" xsi:type="string">banner/image</argument>
			<argument name="allowedExtensions" xsi:type="array">
				<item name="jpg" xsi:type="string">jpg</item>
				<item name="jpeg" xsi:type="string">jpeg</item>
				<item name="gif" xsi:type="string">gif</item>
				<item name="png" xsi:type="string">png</item>
			</argument>
		</arguments>
	</virtualType>
</config>
